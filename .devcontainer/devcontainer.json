{
    "name": "GAS Node.js Dev Environment",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    },
    "mounts": [
        {
            "source": "clasp-config-store",
            "target": "/home/node",
            "type": "volume"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "mhutchie.git-graph",
                "heavensdoor.vscode-jsdoc",
                "streetsidesoftware.code-spell-checker"
            ]
        }
    },
    "postCreateCommand": "npm install -g @google/clasp && npm install --save-dev @types/google-apps-script"
}